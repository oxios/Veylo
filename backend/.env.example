NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/venueflow
JWT_SECRET=<generate-at-least-32-random-characters>
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Used only by `npm run seed`. Never exposed by the API.
SEED_OWNER_NAME=VenueFlow Owner
SEED_OWNER_EMAIL=owner@venueflow.local
SEED_OWNER_PASSWORD=<choose-a-strong-owner-password>
AUTO_SEED_OWNER=true

# Optional AI-assisted layout for uploaded floor-plan images.
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-5.6
OPENAI_CAMERA_VISION_TIMEOUT_MS=45000

# Optional external detector. It must accept multipart field `image` and
# return { model, detections: [{ id, label, confidence, x, y, width, height }] }.
# Coordinates may be 0..1 or percentage 0..100. Without it, OpenAI Vision
# returns compatible boxes; without either engine, a marked test fallback is used.
YOLO_API_URL=
YOLO_DETECT_TIMEOUT_MS=18000
# Optional raw-JPEG AVI frame endpoint. When omitted, the API derives
# /video/frame from YOLO_API_URL.
YOLO_VIDEO_FRAME_URL=
YOLO_API_KEY=
