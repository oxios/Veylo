NODE_ENV=development
PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/venueflow
JWT_SECRET=<generate-at-least-32-random-characters>
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
COOKIE_SECURE=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Used only by `npm run seed`. Never exposed by the API.
SEED_OWNER_NAME=VenueFlow Owner
SEED_OWNER_EMAIL=owner@venueflow.local
SEED_OWNER_PASSWORD=<choose-a-strong-owner-password>
AUTO_SEED_OWNER=true

# Uploaded videos and snapshots; shared with the video worker. Defaults to ./storage/videos.
VIDEO_STORAGE_DIR=
VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_DELETE_AFTER_PROCESSING=true

# Live cameras: RTSP addresses are sealed with CAMERA_SECRET_KEY (required in production).
CAMERA_SECRET_KEY=<generate-at-least-32-random-characters>
# Processing nodes count as offline when their heartbeat is older than this.
NODE_STALE_AFTER_MS=20000
# Optional: token secret of the local node (camera-node connects with vfn_local_<secret>).
LOCAL_NODE_SECRET=
LIVE_TRACK_RETENTION_DAYS=7

# MediaMTX hub (live video relay); MEDIAMTX_SECRET is required in production.
MEDIAMTX_SECRET=<generate-at-least-24-random-characters>
HUB_API_URL=http://127.0.0.1:9997
HUB_WEBRTC_URL=http://127.0.0.1:8889
HUB_RTSP_URL=rtsp://127.0.0.1:8554
