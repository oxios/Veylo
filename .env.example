# Copy this file to .env before the first Docker Compose start.
# Use URL-safe values (letters, digits, - and _) for Mongo credentials because
# they are interpolated into MONGO_URI.

# Keep the API in development mode for local HTTP cookies. The selected
# frontend image target sets its own matching NODE_ENV.
API_NODE_ENV=development
FRONTEND_BUILD_TARGET=production

MONGO_ROOT_USERNAME=venueflow_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGO_DATABASE=venueflow

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SEED_OWNER_NAME=VenueFlow Owner
SEED_OWNER_EMAIL=owner@venueflow.local
SEED_OWNER_PASSWORD=replace-with-a-strong-password

# Live cameras. RTSP addresses are encrypted with CAMERA_SECRET_KEY (32+ random chars; changing it makes
# stored camera passwords unreadable). MEDIAMTX_SECRET authorises the API <-> MediaMTX hub.
# LOCAL_NODE_SECRET lets the processing node of this compose stack (camera-node) connect without the admin panel.
CAMERA_SECRET_KEY=replace-with-at-least-32-random-characters
MEDIAMTX_SECRET=replace-with-at-least-24-random-characters
LOCAL_NODE_SECRET=replace-with-32-url-safe-random-characters
LIVE_TRACK_RETENTION_DAYS=7

# Hub exposure. Remote nodes publish to HUB_RTSP_URL; browsers receive WebRTC from WEBRTC_PUBLIC_HOSTS:8189.
# Local defaults bind to 127.0.0.1; in production use the public host/IP.
HUB_RTSP_BIND=127.0.0.1:8554
HUB_RTSP_URL=rtsp://mediamtx:8554
WEBRTC_BIND=127.0.0.1:8189
WEBRTC_PUBLIC_HOSTS=127.0.0.1

# Local processing node. For an NVIDIA GPU uncomment COMPOSE_FILE (use ":" as separator on Linux/macOS).
# COMPOSE_FILE=docker-compose.yml;docker-compose.gpu.yml
NODE_DEVICE=auto
NODE_CPUS=4.0

# Video pipeline (upload limit, processing nodes).
VIDEO_MAX_UPLOAD_BYTES=2147483648
VIDEO_SAMPLE_FPS=5
LIVE_SAMPLE_FPS=5
VIDEO_MAX_DURATION_SECONDS=14400
VIDEO_DELETE_AFTER_PROCESSING=true
YOLO_CONFIDENCE=0.3
YOLO_IMAGE_SIZE=640
YOLO_TORCH_THREADS=2
