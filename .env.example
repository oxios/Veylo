# Copy this file to .env before the first Docker Compose start.
# Use URL-safe values (letters, digits, - and _) for Mongo credentials because
# they are interpolated into MONGO_URI.

# Keep the API in development mode for local HTTP cookies. The selected
# frontend image target sets its own matching NODE_ENV.
API_NODE_ENV=development
FRONTEND_BUILD_TARGET=production

MONGO_ROOT_USERNAME=venueflow_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGO_DATABASE=venueflow

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SEED_OWNER_NAME=VenueFlow Owner
SEED_OWNER_EMAIL=owner@venueflow.local
SEED_OWNER_PASSWORD=replace-with-a-strong-password

# Optional. The API uses it to analyze uploaded JPG/PNG/WebP floor plans.
# Never expose this value as VITE_* or NEXT_PUBLIC_*.
OPENAI_API_KEY=
OPENAI_PLAN_MODEL=gpt-5.6
OPENAI_CAMERA_VISION_TIMEOUT_MS=35000

# Local CPU YOLO11 worker used by Docker Compose.
YOLO_PORT=8000
YOLO_CONFIDENCE=0.12
YOLO_IOU=0.70
YOLO_IMAGE_SIZE=960
YOLO_TILED_INFERENCE=true
YOLO_TILE_SLICES=3
YOLO_TILE_OVERLAP=0.15
YOLO_MAX_DETECTIONS=120
YOLO_MAX_UPLOAD_BYTES=8388608
YOLO_MAX_IMAGE_PIXELS=25000000
YOLO_DETECT_TIMEOUT_MS=18000
YOLO_MAX_VIDEO_UPLOAD_BYTES=209715200
YOLO_MAX_VIDEO_PIXELS=25000000
YOLO_MAX_VIDEO_DURATION_SECONDS=1800
YOLO_VIDEO_JPEG_QUALITY=88
YOLO_TORCH_THREADS=2
YOLO_API_KEY=
