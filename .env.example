# Copy this file to .env before the first Docker Compose start.
# Use URL-safe values (letters, digits, - and _) for Mongo credentials because
# they are interpolated into MONGO_URI.

# Keep the API in development mode for local HTTP cookies. The selected
# frontend image target sets its own matching NODE_ENV.
API_NODE_ENV=development
FRONTEND_BUILD_TARGET=production

MONGO_ROOT_USERNAME=venueflow_admin
MONGO_ROOT_PASSWORD=replace-with-a-long-url-safe-password
MONGO_DATABASE=venueflow

JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_MAX_AGE_MS=604800000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

SEED_OWNER_NAME=VenueFlow Owner
SEED_OWNER_EMAIL=owner@venueflow.local
SEED_OWNER_PASSWORD=replace-with-a-strong-password
