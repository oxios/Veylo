# syntax=docker/dockerfile:1.7

FROM node:24-bookworm-slim AS dependencies

WORKDIR /app

COPY package.json package-lock.json .npmrc ./

RUN --mount=type=cache,target=/root/.npm \
    npm ci --cache /root/.npm


FROM dependencies AS development

ENV NODE_ENV=development \
    PORT=5173 \
    WRANGLER_WRITE_LOGS=false \
    WRANGLER_LOG_PATH=.wrangler/logs \
    MINIFLARE_REGISTRY_PATH=.wrangler/registry

COPY . .

EXPOSE 5173

CMD ["node", "node_modules/vite/bin/vite.js", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]


FROM dependencies AS build

ENV NODE_ENV=production \
    WRANGLER_WRITE_LOGS=false \
    WRANGLER_LOG_PATH=.wrangler/logs \
    MINIFLARE_REGISTRY_PATH=.wrangler/registry

COPY . .

# Invoke Vinext directly: the repository's npm build wrapper intentionally
# targets the Linux Sites CI environment and requires GNU timeout.
RUN node node_modules/vinext/dist/cli.js build


FROM node:24-bookworm-slim AS production

ENV NODE_ENV=production \
    PORT=5173 \
    FRONTEND_INTERNAL_PORT=3000 \
    VENUEFLOW_API_URL=http://api:4000

WORKDIR /app

COPY --from=dependencies /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/dist ./dist
COPY --from=build /app/scripts/frontend-runtime.mjs ./scripts/frontend-runtime.mjs

EXPOSE 5173

CMD ["node", "scripts/frontend-runtime.mjs"]
